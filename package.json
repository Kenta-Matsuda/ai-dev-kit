{
  "name": "ai-dev-kit",
  "version": "5.0.0",
  "description": "AI コーディングツール（Claude Code ほか）の実行環境をチームで統一する CLI（PKG の clone に aidev init で導入し、設定・権限・LLM Wiki を共有し、aidev から agent を起動する）",
  "bin": {
    "aidev": "cli/bin/aidev.js"
  },
  "main": "cli/bin/aidev.js",
  "scripts": {
    "test": "node test/run.js",
    "lint": "node test/loadall.js",
    "check": "node test/loadall.js && node test/run.js",
    "docs:build": "node scripts/build-docs.js",
    "docs:check": "node scripts/build-docs.js --check",
    "evolve": "node scripts/evolve.js",
    "estimate:backtest": "node scripts/estimate-backtest.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "cli/",
    "templates/",
    "scripts/"
  ],
  "private": true,
  "license": "UNLICENSED",
  "devDependencies": {
    "@asciidoctor/core": "3.0.4",
    "marked": "16.4.2",
    "mermaid": "12.0.0"
  }
}
