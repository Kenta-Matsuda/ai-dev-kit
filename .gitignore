# ai-dev-kit — central kit repository ignores.
#
# Runtime state of a package that uses the kit lives in that package under
# .aidev/ and is ignored by the .aidev/.gitignore the CLI writes there; nothing
# of that kind belongs in this repository.

# --- credential-bearing ---------------------------------------------------------
.env
.env.*
!.env.example
*.pat
*.pem
*.pfx
*.key

# --- generated documentation ------------------------------------------------------
/build/docs/
!ai-dev-kit-user-guide.html

# --- tooling ----------------------------------------------------------------------
node_modules/
npm-debug.log*
*.tsbuildinfo

# --- OS and editor ----------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# --- personal ---------------------------------------------------------------------
.claude/settings.local.json
