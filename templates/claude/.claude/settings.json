{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(.mcp.json)",
      "Edit(.github/copilot-instructions.md)",
      "Edit(.github/agents/**)",
      "Edit(.github/skills/**)",
      "Edit(.github/hooks/**)",
      "Edit(AGENTS.md)",
      "Edit(.codex/**)",
      "Edit(.kiro/steering/**)",
      "Edit(.kiro/agents/**)",
      "Edit(.aidev/policy.yaml)",
      "Edit(.aidev/sync.lock)",
      "Edit(.aidev/materialized.json)",
      "Edit(.aidev/.gitignore)",
      "Edit(.aidev/ejected.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*.key)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(aidev permission configure:*)",
      "Bash(aidev permission reconfigure:*)",
      "Bash(aidev eject:*)",
      "Bash(aidev uninstall:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "aidev hook session-start" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "aidev hook guard-write" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "aidev hook quality-gate" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "aidev hook after-bash" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "aidev hook session-stop" }
        ]
      }
    ]
  }
}
